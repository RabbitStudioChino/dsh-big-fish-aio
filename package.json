  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test tests/*.test.mjs && npm --prefix modules/qq test && npm --prefix modules/memory test && npm --prefix modules/mood test && npm --prefix modules/speak test",
    "prepack": "node scripts/release-policy.mjs && npm run build",
    "lint": "npm run build && eslint . --max-warnings 0",
    "check:public": "node scripts/check-public-files.mjs",
    "check": "npm run lint && npm test && npm run check:public",
    "release": "node scripts/release.mjs",
    "release:check": "node scripts/release.mjs check",
    "scan:secrets": "gitleaks git --redact=100 --log-opts=--all"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RabbitStudioChino/dsh-big-fish-aio.git"
  },
  "homepage": "https://github.com/RabbitStudioChino/dsh-big-fish-aio#readme",
  "bugs": {
    "url": "https://github.com/RabbitStudioChino/dsh-big-fish-aio/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "qq",
    "memory"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "external": [
        "react",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "upstreamCompatibility": [
    {
      "name": "通到 QQ",
      "author": "Yuuyuko-uu",
      "url": "https://github.com/Yuuyuko-uu/dsh-qq-link",
      "version": "1.5.1",
      "commit": "fba7e3ee8ffb3a8f819a7823eb05186cfb782ecb",
      "modulePath": "modules/qq"
    },
    {
      "name": "鱼的记忆",
      "author": "Yuuyuko-uu",
      "url": "https://github.com/Yuuyuko-uu/dsh-fish-memory",
      "version": "1.5.2",
      "commit": "5124cc1fa5a3149e8a68cf1d858e24b5bf2a2eea",
      "modulePath": "modules/memory"
    },
    {
      "name": "鱼的心情",
      "author": "Yuuyuko-uu",
      "url": "https://github.com/Yuuyuko-uu/dsh-feiyu-mood",
      "version": "0.9.0",
      "commit": "02fddcaae0763651ecd65af5f644fe61f19de4bd",
      "modulePath": "modules/mood"
    },
    {
      "name": "主动搭话",
      "author": "Yuuyuko-uu",
      "url": "https://github.com/Yuuyuko-uu/dsh-speak-up",
      "version": "0.3.0",
      "commit": "e3bc6362208c693bb833ecf463ec6a20df4b6419",
      "modulePath": "modules/speak"
    }
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "globals": "17.14.0"
  },
  "dependencies": {
    "stream-json": "3.9.0"
  }
